# AKILI web app — copy to `.env`. Everything here is PUBLIC (it ships to the browser).
# Never put secret keys in this file.

# Base URL of the API, including /api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# WebSocket / realtime server (only if used)
VITE_WS_URL=http://localhost:5000

# Same-domain setup (see ../docs/DEPLOY_SAME_DOMAIN.md): use a relative URL
# VITE_API_BASE_URL=/api/v1
